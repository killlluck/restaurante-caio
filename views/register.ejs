<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Restaurante do Caio | Cadastro</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', sans-serif;
        }

        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #14001a, #2b0033, #000000);
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 24px;
        }

        .container {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(20px);
            border-radius: 20px;
            width: 400px;
            max-width: 100%;
            padding: 40px;
            text-align: center;
            color: white;
            box-shadow: 0 0 40px rgba(199, 125, 255, 0.3);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .logo {
            width: 90px;
            margin-bottom: 15px;
            filter: invert(1);
        }

        h1 {
            color: #c77dff;
            margin-bottom: 5px;
        }

        .subtitle {
            font-size: 14px;
            color: #aaa;
            margin-bottom: 25px;
        }

        .input-group {
            position: relative;
            margin-bottom: 20px;
        }

        .input-group input {
            width: 100%;
            padding: 12px;
            background: transparent;
            border: none;
            border-bottom: 2px solid #555;
            color: white;
            outline: none;
        }

        .input-group label {
            position: absolute;
            left: 0;
            top: 12px;
            color: #888;
            transition: 0.3s;
        }

        .input-group input:focus + label,
        .input-group input:valid + label {
            top: -10px;
            font-size: 12px;
            color: #c77dff;
        }

        .message {
            border-radius: 8px;
            margin-bottom: 18px;
            padding: 10px;
            font-size: 14px;
        }

        .error {
            background: rgba(255, 82, 82, 0.18);
            color: #ffb3b3;
        }

        .success {
            background: rgba(80, 200, 120, 0.18);
            color: #a7f3c1;
        }

        button {
            width: 100%;
            padding: 12px;
            background: linear-gradient(90deg, #7209b7, #c77dff);
            border: none;
            border-radius: 8px;
            color: white;
            font-weight: bold;
            cursor: pointer;
            transition: 0.3s;
        }

        button:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 20px rgba(199, 125, 255, 0.4);
        }

        .extras {
            margin-top: 15px;
            font-size: 13px;
        }

        .extras a {
            color: #c77dff;
            text-decoration: none;
        }

        .extras a:hover {
            text-decoration: underline;
        }
    </style>
</head>

<body>
<div class="container">
    <img src="/logo.png" alt="Logo Restaurante do Caio" class="logo">

    <h1>Criar conta</h1>
    <p class="subtitle">Cadastre seu acesso ao Restaurante do Caio</p>

    <% if (error) { %>
        <div class="message error"><%= error %></div>
    <% } %>

    <% if (success) { %>
        <div class="message success"><%= success %></div>
    <% } %>

    <form action="/register" method="POST">
        <div class="input-group">
            <input type="text" name="username" required>
            <label>Usuario</label>
        </div>

        <div class="input-group">
            <input type="password" name="password" required>
            <label>Senha</label>
        </div>

        <div class="input-group">
            <input type="password" name="confirmPassword" required>
            <label>Confirmar senha</label>
        </div>

        <button type="submit">Cadastrar</button>
    </form>

    <div class="extras">
        <p>Ja tem conta? <a href="/">Entrar</a></p>
    </div>
</div>
</body>
</html>
